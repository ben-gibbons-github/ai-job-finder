# Copy this file to server/.env and fill in values.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3010
# Optional for single-container deploys that serve the built client from Express.
# In Fly runtime this is set to /app/client/dist via fly.toml.
CLIENT_DIST_DIR=

# Cache seeding behavior when running with a mounted cache volume.
# missing: copy only missing files from CACHE_SEED_DIR to cache dir
# overwrite: replace existing cache files from CACHE_SEED_DIR on startup (Fly default)
# off: disable startup cache seeding
CACHE_SEED_MODE=overwrite

GEMINI_API_KEY=your_gemini_api_key_here
CLIMATEBASE_ALGOLIA_API_KEY=
ESCAPE_THE_CITY_ALGOLIA_API_KEY=
EIGHTYK_HOURS_ALGOLIA_API_KEY=
GEOAPIFY_API_KEY=
MAPQUEST_API_KEY=
# Optional high-volume generalist RSS controls (comma-separated query terms)
INDEED_RSS_QUERIES=
INDEED_RSS_LOCATION=United States
INDEED_RSS_LOCATIONS=
CRAIGSLIST_AREAS=
CRAIGSLIST_CATEGORIES=jjj
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
USAJOBS_KEYWORDS=
USAJOBS_MAX_PAGES=6
USAJOBS_RESULTS_PER_PAGE=250
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=
ADZUNA_KEYWORDS=
ADZUNA_MAX_PAGES=6
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_REQUEST_DELAY_MS=400
ADZUNA_RATE_LIMIT_COOLDOWN_MS=600000
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=
JOOBLE_LOCATIONS=
JOOBLE_MAX_PAGES=5
REED_API_KEY=
REED_KEYWORDS=
REED_LOCATIONS=
REED_MAX_PAGES=6
REED_RESULTS_PER_PAGE=100
ASHBY_FEED_ENDPOINTS=
# Leave these empty to use expanded built-in default board/org packs.
ASHBY_ORGS=
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# Audit-all control knobs
AUDIT_ALL_MAX_CONCURRENCY=4
AUDIT_ALL_MAX_JOBS=250

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Socket leaky-bucket rate limits (capacity, leak-per-second)
SOCKET_RATE_LIMIT_HELLO_CAPACITY=10
SOCKET_RATE_LIMIT_HELLO_LEAK_PER_SECOND=2

SOCKET_RATE_LIMIT_SEARCH_CAPACITY=20
SOCKET_RATE_LIMIT_SEARCH_LEAK_PER_SECOND=1.5

SOCKET_RATE_LIMIT_AUDIT_ALL_CAPACITY=2
SOCKET_RATE_LIMIT_AUDIT_ALL_LEAK_PER_SECOND=0.03

SOCKET_RATE_LIMIT_LOCATION_CAPACITY=25
SOCKET_RATE_LIMIT_LOCATION_LEAK_PER_SECOND=3

SOCKET_RATE_LIMIT_JOB_AUDIT_CAPACITY=8
SOCKET_RATE_LIMIT_JOB_AUDIT_LEAK_PER_SECOND=0.4
